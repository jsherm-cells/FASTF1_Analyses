os.environ['F1_USERNAME'] = input('F1 account email: ')
os.environ['F1_PASSWORD'] = getpass.getpass('F1 account password: ')

print('Credentials Configured')

result = subprocess.run(
    [
        sys.executable,
        '-m',
        'fastf1',
        'auth',
        'f1tv',
        '--authenticate'
    ],
    capture_output=True,
    text=True
)

print('Return code:', result.returncode)
print(result.stdout)
print(result.stderr)
